@model ReportViewModel
@{
    ViewData["Title"] = "Expense Report";
    var months = Enumerable.Range(1, 12).Select(m => new { Value = m, Name = new DateTime(2000, m, 1).ToString("MMMM") });
}
<div class="container py-4">
    <h3 class="fw-bold mb-3"><i class="bi bi-bar-chart-line text-primary me-1"></i>Expense Report</h3>

    <form method="get" asp-action="ExpenseReport" class="row g-2 align-items-end mb-4">
        <div class="col-md-3">
            <label class="form-label small">Month</label>
            <select name="month" class="form-select form-select-sm">
                @foreach (var m in months)
                {
                    <option value="@m.Value" selected="@(m.Value == Model.Summary.Month)">@m.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Year</label>
            <input type="number" name="year" value="@Model.Summary.Year" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm">View Report</button>
        </div>
    </form>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card p-3">
                <h5 class="fw-bold mb-3">Spending by Category</h5>
                @if (!Model.ExpenseByCategory.Any())
                {
                    <p class="text-muted mb-0">No expense data for this month.</p>
                }
                else
                {
                    <canvas id="categoryPieChart" height="220"></canvas>
                    <table class="table table-sm mt-3">
                        <tbody>
                            @foreach (var c in Model.ExpenseByCategory)
                            {
                                <tr>
                                    <td>@c.CategoryName</td>
                                    <td class="text-end fw-semibold">₹@c.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-3">
                <h5 class="fw-bold mb-3">Monthly Income vs Expense (Last 6 Months)</h5>
                <canvas id="incomeExpenseBarChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
    <script>
        const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseByCategory.Select(c => c.CategoryName)));
        const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseByCategory.Select(c => c.TotalAmount)));
        renderCategoryPieChart("categoryPieChart", categoryLabels, categoryData);

        const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartMonthLabels));
        const incomeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartMonthlyIncome));
        const expenseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartMonthlyExpense));
        renderIncomeExpenseBarChart("incomeExpenseBarChart", monthLabels, incomeData, expenseData);
    </script>
}
