@{
    ViewData["Title"] = "About";
}
<div class="container py-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-6">
            <h2 class="fw-bold">About Personal Expense Tracker</h2>
            <p class="text-muted">
                Personal Expense Tracker is a web application built to help individuals record their
                daily income and expenses, organize them by category, set monthly budgets and understand
                their spending habits through simple visual reports.
            </p>
            <p class="text-muted">
                This project was developed as a college mini project using ASP.NET Core MVC, Entity
                Framework Core and SQL Server, demonstrating a complete full-stack web application with
                secure authentication, CRUD operations and data-driven reporting.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="card p-4">
                <h6 class="fw-bold mb-3">Built With</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>ASP.NET Core MVC (.NET 8)</li>
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Entity Framework Core (Code First)</li>
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>SQL Server / LocalDB</li>
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Bootstrap 5 &amp; Bootstrap Icons</li>
                    <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Chart.js for reporting</li>
                    <li class="mb-0"><i class="bi bi-check-circle text-success me-2"></i>Cookie-based authentication</li>
                </ul>
            </div>
        </div>
    </div>
</div>
