@{
    var code = ViewData["StatusCodeValue"];
    ViewData["Title"] = "Page Not Found";
}
<div class="container py-5 text-center min-vh-60">
    <i class="bi bi-signpost-split display-1 text-secondary"></i>
    <h1 class="mt-3">@code — Page Not Found</h1>
    <p class="text-muted">The page you're looking for doesn't exist or has been moved.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house me-1"></i>Back to Home
    </a>
</div>
