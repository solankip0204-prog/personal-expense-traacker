@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <h2 class="fw-bold">Welcome back, @Model.UserName! <i class="bi bi-hand-thumbs-up text-success"></i></h2>
    <p class="text-muted">Here's a summary of your finances.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card income p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Total Income</div>
                        <div class="stat-value text-success">₹@Model.TotalIncome.ToString("N2")</div>
                    </div>
                    <i class="bi bi-arrow-down-circle fs-2 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card expense p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Total Expenses</div>
                        <div class="stat-value text-danger">₹@Model.TotalExpenses.ToString("N2")</div>
                    </div>
                    <i class="bi bi-arrow-up-circle fs-2 text-danger"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card balance p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Balance</div>
                        <div class="stat-value text-primary">₹@Model.Balance.ToString("N2")</div>
                    </div>
                    <i class="bi bi-wallet2 fs-2 text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card monthly p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">This Month's Expenses</div>
                        <div class="stat-value text-warning">₹@Model.CurrentMonthExpenses.ToString("N2")</div>
                    </div>
                    <i class="bi bi-calendar3 fs-2 text-warning"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-lg-8">
            <div class="card p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Transactions</h5>
                    <span class="badge bg-secondary">@Model.TransactionCount total</span>
                </div>
                @if (!Model.RecentTransactions.Any())
                {
                    <p class="text-muted mb-0">No transactions yet. Start by adding an income or expense.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-clean align-middle">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Category</th>
                                    <th>Description</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.RecentTransactions)
                                {
                                    <tr>
                                        <td>
                                            @if (t.Type == "Income")
                                            {
                                                <span class="badge badge-income">Income</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-expense">Expense</span>
                                            }
                                        </td>
                                        <td>@t.CategoryName</td>
                                        <td>@t.Description</td>
                                        <td>@t.Date.ToString("dd MMM yyyy")</td>
                                        <td class="text-end fw-semibold">₹@t.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <a asp-controller="Transaction" asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">
                    View All Transactions
                </a>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card p-3">
                <h5 class="fw-bold mb-3">Quick Actions</h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Income" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Add Income
                    </a>
                    <a asp-controller="Expense" asp-action="Create" class="btn btn-outline-danger">
                        <i class="bi bi-plus-circle me-1"></i>Add Expense
                    </a>
                    <a asp-controller="Transaction" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-list-check me-1"></i>View Transactions
                    </a>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-person me-1"></i>My Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
