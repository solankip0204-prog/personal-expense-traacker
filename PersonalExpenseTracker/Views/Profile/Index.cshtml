@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-person-circle text-success me-1"></i>My Profile</h4>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Full Name</dt><dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Phone Number</dt><dd class="col-sm-8">@Model.PhoneNumber</dd>
                    <dt class="col-sm-4">Member Since</dt><dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
                </dl>
                <div class="mt-3 d-flex gap-2">
                    <a asp-action="Edit" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary"><i class="bi bi-key me-1"></i>Change Password</a>
                </div>
            </div>
        </div>
    </div>
</div>
