@model Category
@{
    ViewData["Title"] = "Delete Category";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4 border-danger">
                <h4 class="fw-bold mb-3 text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Delete Category</h4>
                @if (ViewBag.InUse == true)
                {
                    <div class="alert alert-warning">
                        This category is currently used by existing transactions and cannot be deleted.
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                }
                else
                {
                    <p>Are you sure you want to delete "<strong>@Model.CategoryName</strong>"?</p>
                    <form asp-action="Delete" asp-route-id="@Model.CategoryId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Confirm Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
