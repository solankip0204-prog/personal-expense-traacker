@model List<Category>
@{
    ViewData["Title"] = "Categories";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0"><i class="bi bi-tags text-success me-1"></i>Categories</h3>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Category</a>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card p-3">
                <h5 class="fw-bold">Expense Categories</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var c in Model.Where(c => c.CategoryType == CategoryType.Expense))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@c.CategoryName @if (c.UserId == null) { <span class="badge bg-secondary ms-1">Default</span> }</span>
                            @if (c.UserId != null)
                            {
                                <span>
                                    <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                </span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-3">
                <h5 class="fw-bold">Income Categories</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var c in Model.Where(c => c.CategoryType == CategoryType.Income))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@c.CategoryName @if (c.UserId == null) { <span class="badge bg-secondary ms-1">Default</span> }</span>
                            @if (c.UserId != null)
                            {
                                <span>
                                    <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                </span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
