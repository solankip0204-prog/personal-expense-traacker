@model LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}
<div class="card auth-card p-4">
    <h3 class="fw-bold text-center mb-1"><i class="bi bi-shield-lock text-success"></i> Admin Login</h3>
    <p class="text-muted text-center mb-4">Restricted area for administrators only.</p>

    <div class="alert alert-info small">
        Demo credentials — Email: <strong>admin@gmail.com</strong>, Password: <strong>Admin@123</strong>
        <br /><span class="text-muted">These are demo credentials for college project demonstration only.</span>
    </div>

    <form asp-controller="Account" asp-action="AdminLogin" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 fw-semibold">
            <i class="bi bi-shield-check me-1"></i>Login as Admin
        </button>
    </form>

    <p class="text-center small text-muted mt-3 mb-0">
        <a asp-controller="Account" asp-action="Login">Back to user login</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
