@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="container py-4">
    <h3 class="fw-bold mb-4"><i class="bi bi-speedometer2 text-success me-1"></i>Admin Dashboard</h3>

    <div class="row g-3">
        <div class="col-md-4 col-sm-6">
            <div class="card stat-card p-3">
                <div class="text-muted small">Total Users</div>
                <div class="stat-value">@ViewBag.TotalUsers</div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card stat-card income p-3">
                <div class="text-muted small">Total Income Transactions</div>
                <div class="stat-value text-success">@ViewBag.TotalIncomeTransactions</div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card stat-card expense p-3">
                <div class="text-muted small">Total Expense Transactions</div>
                <div class="stat-value text-danger">@ViewBag.TotalExpenseTransactions</div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card stat-card p-3">
                <div class="text-muted small">Total Categories</div>
                <div class="stat-value">@ViewBag.TotalCategories</div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card stat-card balance p-3">
                <div class="text-muted small">Total Transaction Amount</div>
                <div class="stat-value text-primary">₹@(((decimal)ViewBag.TotalTransactionAmount).ToString("N2"))</div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card stat-card expense p-3">
                <div class="text-muted small">Total Expenses Amount</div>
                <div class="stat-value text-danger">₹@(((decimal)ViewBag.TotalExpensesAmount).ToString("N2"))</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-md-3 col-sm-6">
            <a asp-action="Users" class="btn btn-outline-primary w-100 py-3"><i class="bi bi-people d-block fs-3 mb-1"></i>Manage Users</a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-action="Categories" class="btn btn-outline-primary w-100 py-3"><i class="bi bi-tags d-block fs-3 mb-1"></i>Manage Categories</a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-action="Transactions" class="btn btn-outline-primary w-100 py-3"><i class="bi bi-list-check d-block fs-3 mb-1"></i>Manage Transactions</a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a asp-action="Reports" class="btn btn-outline-primary w-100 py-3"><i class="bi bi-bar-chart d-block fs-3 mb-1"></i>View Reports</a>
        </div>
    </div>
</div>
