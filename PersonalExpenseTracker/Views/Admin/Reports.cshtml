@{
    ViewData["Title"] = "Admin Reports";
}
<div class="container py-4">
    <h3 class="fw-bold mb-3"><i class="bi bi-bar-chart text-success me-1"></i>System-Wide Reports</h3>
    <div class="card p-3">
        <h5 class="fw-bold mb-3">Total Expenses by Category (All Users)</h5>
        <canvas id="adminCategoryChart" height="280"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryLabels));
        const totals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryTotals));
        renderCategoryPieChart("adminCategoryChart", labels, totals);
    </script>
}
