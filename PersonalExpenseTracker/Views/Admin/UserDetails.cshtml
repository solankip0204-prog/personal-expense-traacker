@model User
@{
    ViewData["Title"] = "User Details";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-person-badge text-success me-1"></i>User Details</h4>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Full Name</dt><dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Phone Number</dt><dd class="col-sm-8">@Model.PhoneNumber</dd>
                    <dt class="col-sm-4">Registered On</dt><dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-sm-4">Expense Records</dt><dd class="col-sm-8">@ViewBag.ExpenseCount (₹@(((decimal)ViewBag.TotalExpenses).ToString("N2")))</dd>
                    <dt class="col-sm-4">Income Records</dt><dd class="col-sm-8">@ViewBag.IncomeCount (₹@(((decimal)ViewBag.TotalIncome).ToString("N2")))</dd>
                </dl>
                <p class="text-muted small mt-3 mb-0"><i class="bi bi-shield-lock"></i> Password is securely hashed and never displayed.</p>
                <a asp-action="Users" class="btn btn-outline-secondary mt-3">Back to Users</a>
            </div>
        </div>
    </div>
</div>
